# 상담 신청 메일(SMTP) — 비워 두면 FormSubmit(formsubmit.co)으로 대신 보냅니다.
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=보내는 계정, SMTP_PASS=앱 비밀번호(16자리)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 보내는 사람 주소(기본: SMTP_USER)
SMTP_FROM=
# 받는 주소(기본: info@pause8studio.com)
CONTACT_TO=
# 서버 포트(기본 3000)
PORT=3000
# 로드밸런서·프록시 뒤라면 단계 수(기본 1). 프록시 없이 바로 열면 false — 방문자 IP(통화 판별)를 바르게 읽는 데 필요
TRUST_PROXY=1
# 통화 판별(뉴질랜드만 NZD, 그 밖의 나라와 판별 실패는 USD): 앞단이 국가를 알려 주면 그 헤더 이름(믿을 수 있는 것만)
#   Cloudflare 프록시 → cf-ipcountry / 구글 부하분산기 사용자 지정 헤더 'X-Client-Geo-Location:{client_region}' → x-client-geo-location
#   비워 두면 서버에 들어 있는 뉴질랜드 IP 목록(src/geo/nz-ip.json)으로 판별. 배포 후 /api/currency 로 확인
GEO_HEADER=
# 점검용으로만 ?cur=nzd|usd 덮어쓰기를 켬(운영에서는 비워 둠 — 방문자가 통화를 고를 수 없게)
CURRENCY_OVERRIDE=
