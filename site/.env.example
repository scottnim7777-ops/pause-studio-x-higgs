# 상담 신청 메일(SMTP) — 비워 두면 FormSubmit(formsubmit.co)으로 대신 보냅니다.
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=보내는 계정, SMTP_PASS=앱 비밀번호(16자리)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 보내는 사람 주소(기본: SMTP_USER)
SMTP_FROM=
# 받는 주소(기본: scottnim7777@gmail.com)
CONTACT_TO=
# 서버 포트(기본 3000)
PORT=3000
# 로드밸런서·프록시 뒤라면 단계 수(기본 1). 프록시 없이 바로 열면 false
TRUST_PROXY=1
