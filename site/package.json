{
  "name": "pause-studio-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "PAUSE STUDIO 웹사이트 (2026 리뉴얼)",
  "scripts": {
    "render": "tsx scripts/render.ts",
    "dev": "npm run render && tsx server.ts",
    "build": "npm run render && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "axe-core": "^4.10.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=20"
  }
}
